# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ⚠️  REQUIRED: Get this from Supabase Dashboard → Project Settings → API → service_role key
# This key bypasses RLS and must NEVER be exposed to the frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Frontend (Vite reads VITE_ prefixed vars)
# ============================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================
# AI Services
# ============================================
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# Python BKT Microservice URL
BKT_SERVICE_URL=http://localhost:8000

# APP_URL: The URL where this app is hosted (for OAuth callbacks, etc.)
APP_URL=http://localhost:3000